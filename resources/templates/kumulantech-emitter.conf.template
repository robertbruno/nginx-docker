# Emitter WebSocket — emitter.kumulantech.com
# TLS terminates at ALB. WebSocket upgrade preserved.
server {
    listen 80;
    server_name ${FQDN_KUMULANTECH_EMITTER};

    set $upstream_emitter "${UPSTREAM_EMITTER}";

    location / {
        proxy_pass $upstream_emitter;
        include /etc/nginx/utils/host;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 36000s;
        proxy_redirect off;
    }

    location /health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
